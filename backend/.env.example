# FieldShift Backend Environment Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Start with fictional local sample data. Set false to enable live data sources.
DEMO_MODE=true

# Durable external response cache lifetimes (seconds)
ENVIRONMENT_CACHE_TTL_SECONDS=21600
TREND_CACHE_TTL_SECONDS=86400
STALE_CACHE_GRACE_SECONDS=604800

# NASA Earthdata / APIs (Optional for live mode; fallback to demo mode if unset)
NASA_EARTHDATA_USERNAME=
NASA_EARTHDATA_PASSWORD=
# Create a bearer token at https://urs.earthdata.nasa.gov/profile
# Required for live SMAP, GPM IMERG, and SRTM granule downloads.
NASA_EARTHDATA_TOKEN=
NASA_CMR_API_URL=https://cmr.earthdata.nasa.gov/search/granules.json
NASA_POWER_API_URL=https://power.larc.nasa.gov/api/temporal/daily/point

# Live Earthdata download limits
EARTHDATA_TIMEOUT_SECONDS=30
EARTHDATA_MAX_DOWNLOAD_MB=150
GPM_MONTHS_TO_ANALYZE=12

# ISRIC SoilGrids REST API
SOILGRIDS_API_URL=https://rest.isric.org/soilgrids/v2.0/properties/query

# USDA NRCS Soil Data Access (SSURGO/STATSGO2; U.S. coverage)
USDA_SOIL_DATA_API_URL=https://sdmdataaccess.sc.egov.usda.gov/Tabular/post.rest
USDA_SOIL_TIMEOUT_SECONDS=20

# Google Earth Engine (Optional - enables live Landsat, MODIS, and VIIRS NDVI)
GEE_SERVICE_ACCOUNT=
GEE_PRIVATE_KEY_FILE=

# Supabase / Database (Optional - defaults to local SQLite with PostGIS GeoJSON compatibility)
DATABASE_URL=sqlite:///./fieldshift.db
SUPABASE_URL=
SUPABASE_KEY=
